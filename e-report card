        </tr>

        <tr>
            <td>IT 202</td>
            <td>Database Management</td>
            <td>3</td>
            <td>89</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>IT 203</td>
            <td>Object-Oriented Programming</td>
            <td>3</td>
            <td>91</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>IT 204</td>
            <td>Computer Networks</td>
            <td>3</td>
            <td>87</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>IT 205</td>
            <td>Systems Analysis and Design</td>
            <td>3</td>
            <td>90</td>
            <td class="passed">Passed</td>
        </tr>

        <tr>
            <td>GE 201</td>
