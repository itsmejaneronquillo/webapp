<!DOCTYPE html>
<html>
<head> 
    <title> E-Report Card</title>

    <style>
    body {
            font-family: Arial, sans-serif;
            background: #eef2f7;
            margin: 0;
            padding: 30px;
        }

        .report {
            width: 80%;
            margin: auto;
            background: white;
            padding: 20px;
            box-shadow: 0 0 10px gray;
        }

        h2 {
            text-align: center;
            color: #1f4e79;
            font-size: 18px;
        }

        h4 {
            color: #1f4e79;
            border-bottom: 1px solid #1f4e79;
            padding-bottom: 6px;
            margin-bottom: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            margin-bottom: 10px;
        }

        th {
            background: #1f4e79;
            color: white;
            padding: 6px;
        }

        td {
            padding: 5px;
            text-align: center;
        }

        tr:nth-child(even) {
            background: #eeeeee;
        }

        .info td {
            text-align: left;
        }

        .label {
            background: #e5f0f5;
            font-weight: bold;
        }

        .white {
            background: white;
        }

        .passed {
            color: green;
        }

        /* General Average row */
        .average td {
            background: #1f4e79;
            color: white;
            font-weight: bold;
            padding: 6px;
        }

        .footer {
            text-align: center;
            font-size: 10px;
            color: #555;
        }

    </style>

</head>

<body>
<div class="report">

    <h2>E-REPORT CARD</h2>

    <h4>Student Information</h4>

    <table class="info">

